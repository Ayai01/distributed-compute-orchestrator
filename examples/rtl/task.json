{
  "label": "verilator",
  "timeout": 600,
  "steps": [
    [
      "${tool:verilator}",
      "--binary",
      "--assert",
      "-j",
      "${cpus}",
      "--Mdir",
      "obj_dir",
      "--top-module",
      "tb",
      "tb.sv"
    ],
    [
      "${work}/obj_dir/Vtb${exe}"
    ]
  ],
  "outputs": [
    "metrics.json"
  ],
  "max_cpus": 1024
}
